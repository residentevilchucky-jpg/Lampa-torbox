
/* Lampa TorBox PT-BR — v1.0.0
 * Samsung TV / Media Station X
 * Integração com a API do TorBox.
 */
(function () {
    'use strict';

    if (window.lampa_torbox_ptbr_loaded) return;
    window.lampa_torbox_ptbr_loaded = true;

    var STORE_KEY = 'ltbptbr_api_key';
    var COMPONENT = 'ltbptbr_screen';
    var API = 'https://api.torbox.app/v1/api';

    function notify(message) {
        if (window.Lampa && Lampa.Noty) Lampa.Noty.show(message);
        else alert(message);
    }

    function apiKey() {
        return (Lampa.Storage.get(STORE_KEY) || '').trim();
    }

    function request(path, options) {
        options = options || {};
        options.headers = options.headers || {};
        options.headers.Authorization = 'Bearer ' + apiKey();
        options.headers.Accept = 'application/json';

        return fetch(API + path, options).then(function (response) {
            return response.text().then(function (body) {
                var data;
                try {
                    data = JSON.parse(body);
                } catch (e) {
                    data = { detail: body };
                }

                if (!response.ok || data.success === false) {
                    throw new Error(
                        data.detail || data.error || ('HTTP ' + response.status)
                    );
                }

                return data;
            });
        });
    }

    function isPortugueseBR(name) {
        return /(pt[\s._-]?br|pob|por[\s._-]?br|brazilian|brasileir|portugu[eê]s)/i.test(name || '');
    }

    function bytes(value) {
        var n = Number(value || 0);
        if (!n) return '';

        var units = ['B', 'KB', 'MB', 'GB', 'TB'];
        var i = 0;

        while (n >= 1024 && i < units.length - 1) {
            n /= 1024;
            i++;
        }

        return n.toFixed(i ? 1 : 0) + ' ' + units[i];
    }

    function openScreen(card) {
        Lampa.Activity.push({
            url: '',
            title: 'TorBox PT-BR',
            component: COMPONENT,
            movie: card || {},
            page: 1
        });
    }

    function TorBoxScreen() {
        var html = $('<div class="ltbptbr screen--settings"><div class="ltbptbr__body"></div></div>');
        var body = html.find('.ltbptbr__body');
        var busy = false;

        function message(text) {
            body.html(
                '<div class="ltbptbr__message">' +
                $('<div>').text(text).html() +
                '</div>'
            );
        }

        function renderHeader() {
            body.html(
                '<div class="ltbptbr__head">' +
                    '<div class="ltbptbr__title">TORBOX <span>PT-BR</span></div>' +
                    '<div class="ltbptbr__sub">Sua conta TorBox na Lampa</div>' +
                    '<div class="ltbptbr__actions">' +
                        '<div class="ltbptbr__btn selector" data-action="refresh">Atualizar lista</div>' +
                        '<div class="ltbptbr__btn selector" data-action="magnet">Adicionar magnet</div>' +
                        '<div class="ltbptbr__btn selector" data-action="key">Configurar API Key</div>' +
                    '</div>' +
                '</div>' +
                '<div class="ltbptbr__list"></div>' +
                '<div class="ltbptbr__foot">PT-BR provável pelo nome do arquivo. Confirme o áudio antes de assistir.</div>'
            );

            body.find('[data-action="refresh"]').on('hover:enter click', loadList);
            body.find('[data-action="magnet"]').on('hover:enter click', addMagnet);
            body.find('[data-action="key"]').on('hover:enter click', editKey);
        }

        function editKey() {
            var current = apiKey();

            Lampa.Modal.open({
                title: 'API Key do TorBox',
                html:
                    '<div class="modal__text">Cole sua API Key do TorBox.</div>' +
                    '<input type="text" id="ltbptbr-key-input" class="input" value="' +
                    $('<div>').text(current).html() +
                    '" placeholder="Sua API Key" />',

                buttons: [{
                    name: 'Salvar',
                    onSelect: function () {
                        var value = ($('#ltbptbr-key-input').val() || '').trim();

                        Lampa.Storage.set(STORE_KEY, value);
                        Lampa.Modal.close();

                        notify(value ? 'API Key salva.' : 'API Key apagada.');

                        if (value) loadList();
                    }
                }, {
                    name: 'Cancelar',
                    onSelect: function () {
                        Lampa.Modal.close();
                    }
                }]
            });
        }

        function addMagnet() {
            Lampa.Modal.open({
                title: 'Adicionar magnet',
                html:
                    '<div class="modal__text">Cole um link magnet de conteúdo que você tenha direito de acessar. Só será adicionado se já estiver em cache.</div>' +
                    '<input type="text" id="ltbptbr-magnet-input" class="input" placeholder="magnet:?xt=urn:btih:..." />',

                buttons: [{
                    name: 'Adicionar se estiver em cache',
                    onSelect: function () {
                        var magnet = ($('#ltbptbr-magnet-input').val() || '').trim();

                        if (magnet.indexOf('magnet:?') !== 0) {
                            notify('Cole um link magnet válido.');
                            return;
                        }

                        Lampa.Modal.close();
                        createTorrent(magnet);
                    }
                }, {
                    name: 'Cancelar',
                    onSelect: function () {
                        Lampa.Modal.close();
                    }
                }]
            });
        }

        function createTorrent(magnet) {
            if (busy) return;

            busy = true;
            message('Verificando e adicionando no TorBox...');

            var form = new FormData();
            form.append('magnet', magnet);
            form.append('add_only_if_cached', 'true');

            request('/torrents/createtorrent', {
                method: 'POST',
                body: form
            })
            .then(function (result) {
                busy = false;
                notify((result.detail || 'Solicitação concluída.') + ' Atualizando lista...');
                loadList();
            })
            .catch(function (error) {
                busy = false;
                message('Não foi possível adicionar: ' + error.message);
                notify('TorBox: ' + error.message);
            });
        }

        function loadList() {
            if (!apiKey()) {
                renderHeader();
                message('Configure sua API Key do TorBox.');
                return;
            }

            if (busy) return;

            busy = true;
            renderHeader();

            body.find('.ltbptbr__list').html(
                '<div class="ltbptbr__message">Carregando seus arquivos...</div>'
            );

            request('/torrents/mylist?bypass_cache=true&limit=100&files=true')
            .then(function (result) {
                var items = Array.isArray(result.data) ? result.data : [];
                drawItems(items);
            })
            .catch(function (error) {
                body.find('.ltbptbr__list').html(
                    '<div class="ltbptbr__message">Erro: ' +
                    $('<div>').text(error.message).html() +
                    '</div>'
                );
            })
            .then(function () {
                busy = false;
            });
        }

        function drawItems(items) {
            var list = body.find('.ltbptbr__list').empty();

            if (!items.length) {
                list.html(
                    '<div class="ltbptbr__message">Sua lista está vazia. Use Adicionar magnet.</div>'
                );
                return;
            }

            items.forEach(function (item) {
                var name = item.name || item.hash || ('Torrent #' + item.id);
                var files = Array.isArray(item.files) ? item.files : [];
                var state = item.download_state || item.status || 'Status indisponível';

                var card = $('<div class="ltbptbr__item"></div>');

                card.append('<div class="ltbptbr__name"></div>');
                card.find('.ltbptbr__name').text(name);

                card.append('<div class="ltbptbr__meta"></div>');
                card.find('.ltbptbr__meta').text(
                    state +
                    (item.size ? ' • ' + bytes(item.size) : '') +
                    ' • ' + files.length + ' arquivo(s)'
                );

                if (files.length) {
                    var fileButton = $(
                        '<div class="ltbptbr__btn selector">Ver arquivos</div>'
                    );

                    fileButton.on('hover:enter click', function () {
                        showFiles(item, files);
                    });

                    card.append(fileButton);
                } else {
                    card.append(
                        '<div class="ltbptbr__meta">Aguardando arquivos ou processamento</div>'
                    );
                }

                list.append(card);
            });

            Lampa.Controller.enable('content');
        }

        function showFiles(item, files) {
            var choices = files.filter(function (file) {
                return /\.(mkv|mp4|avi|mov|m4v|webm)$/i.test(
                    file.name || file.short_name || ''
                );
            }).map(function (file) {
                var filename = file.name || file.short_name || 'Arquivo de vídeo';

                var label = (
                    isPortugueseBR(filename)
                    ? 'PT-BR provável — '
                    : 'Idioma não confirmado — '
                ) + filename;

                return {
                    title: label,
                    subtitle: bytes(file.size),
                    file: file,
                    item: item
                };
            });

            if (!choices.length) {
                notify('Nenhum arquivo de vídeo reconhecido neste torrent.');
                return;
            }

            Lampa.Select.show({
                title: 'Arquivos — ' + (item.name || 'TorBox'),
                items: choices,

                onSelect: function (choice) {
                    playFile(choice.item, choice.file);
                },

                onBack: function () {
                    Lampa.Controller.toggle('content');
                }
            });
        }

        function playFile(item, file) {
            var torrentId = item.id || item.torrent_id;
            var fileId = file.id;

            if (torrentId == null || fileId == null) {
                notify('O TorBox não informou o ID do torrent/arquivo.');
                return;
            }

            var url = API + '/torrents/requestdl?token=' +
                encodeURIComponent(apiKey()) +
                '&torrent_id=' + encodeURIComponent(torrentId) +
                '&file_id=' + encodeURIComponent(fileId) +
                '&redirect=true';

            Lampa.Player.play({
                url: url,
                title: file.name || item.name || 'TorBox',
                quality: 'auto'
            });
        }

        this.create = function () {
            renderHeader();

            if (!apiKey()) {
                message('Configure sua API Key para conectar ao TorBox.');
            } else {
                loadList();
            }
        };

        this.start = function () {};
        this.render = function () { return html; };
        this.pause = function () {};
        this.stop = function () {};
        this.destroy = function () { html.remove(); };
        this.back = function () { Lampa.Activity.backward(); };
    }

    function init() {
        if (!window.Lampa || !Lampa.SettingsApi || !Lampa.Component) return;

        Lampa.SettingsApi.addComponent({
            component: 'ltbptbr_settings',
            name: 'TorBox PT-BR',
            icon: '<svg width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="44" height="44" rx="8" fill="currentColor" opacity=".15"/><path d="M12 14h20v4H12zm0 8h20v4H12zm0 8h13v4H12z" fill="currentColor"/></svg>'
        });

        Lampa.SettingsApi.addParam({
            component: 'ltbptbr_settings',
            param: {
                name: STORE_KEY,
                type: 'input',
                default: '',
                placeholder: 'Cole sua API Key do TorBox'
            },
            field: {
                name: 'API Key',
                description: 'A chave fica salva localmente na Lampa. Não compartilhe com ninguém.'
            }
        });

        if (!Lampa.Component.get(COMPONENT)) {
            Lampa.Component.add(COMPONENT, TorBoxScreen);
        }

        Lampa.Manifest.plugins = {
            type: 'video',
            version: '1.0.0',
            name: 'TorBox PT-BR',
            description: 'Integração TorBox em português para Samsung TV',

            onContextMenu: function () {
                return {
                    name: 'Abrir TorBox PT-BR',
                    description: 'Ver arquivos da sua conta TorBox'
                };
            },

            onContextLauch: function (card) {
                openScreen(card);
            }
        };

        Lampa.Lang.add({
            ltbptbr_title: {
                pt: 'TorBox PT-BR',
                en: 'TorBox PT-BR'
            }
        });

        console.log('[TorBox PT-BR] Plugin carregado v1.0.0');
    }

    if (window.appready) {
        init();
    } else {
        Lampa.Listener.follow('app', function (event) {
            if (event.type === 'ready') init();
        });
    }
})();
